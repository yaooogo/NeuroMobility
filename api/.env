[mysql]
DB_DATABASE=neuro_mobility
DB_PORT=3306
DB_HOST="localhost"
DB_USERNAME="root"
DB_PASSWORD="root"
DB_PREFIX=n_
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=100
DB_DATE_TIMESTRINGS=true


[redis]
REDIS_HOST = localhost
REDIS_PORT = 6379
REDIS_PASSWORD = ''
REDIS_PREFIX = "n_"

[page]
DEFAULT_PAGE_SIZE=10 #default page size
MAX_PAGE_SIZE=100 #max page size

[app listen port]
API_PORT=3000

[manage listen port]
MANAGE_API_PORT=3001
OPEN_GOOGLE_AUTHENTICATION=false

[upload]
UPLOAD_TYPE=file #file || aws
UPLOAD_ROOT="./upload"
UPLOAD_DOMAIN="http://127.0.0.1:8080"
UPLOAD_MAX_SIZE_MB=5

